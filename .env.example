DJANGO_SECRET_KEY=django-insecure-local-dev-only-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
HOST_PORT=8000

# Windows example: C:/Users/your-name
# macOS example: /Users/your-name
# Linux example: /home/your-name
HOST_HOME=C:/Users/your-name

# Linux users can set these to the output of `id -u` and `id -g`.
APP_UID=1000
APP_GID=1000
